    "schemes": {
        "badge": "GOVERNMENT SCHEMES",
        "title": "Oilseed Farmer Support Programs",
        "subtitle": "Comprehensive government initiatives to boost oilseed production and farmer prosperity",
        "budgetLabel": "Budget",
        "durationLabel": "Duration",
        "impact": "Impact",
        "learnMore": "Learn More",
        "nmeo": {
            "title": "National Mission on Edible Oils – Oilseeds (NMEO-Oilseeds)",
            "description": "A flagship central government mission to boost domestic oilseed production from 39 million tonnes (2022-23) to about 69.7 million tonnes by 2030-31.",
            "budget": "₹10,103 crore",
            "duration": "2024-25 to 2030-31",
            "benefits": "Key Benefits",
            "benefit1": "Access to high-yielding & high oil content seeds for rapeseed-mustard, groundnut, soybean, sunflower, sesame",
            "benefit2": "Quality inputs, GAP training, and advisory services for farmers",
            "benefit3": "Infrastructure build-up: seed hubs, storage units, and value chain clusters across districts",
            "benefit4": "Promotes FPOs, cooperatives, and private sector partnerships for sustainable growth",
            "target": "Helps reduce dependency on edible oil imports and increases farmers' profitability through improved yields and market access"
        },
        "freeSeeds": {
            "title": "Free Oilseed Seeds & Input Support",
            "description": "Under NMEO, farmers receive free climate-smart & improved oilseed seeds — soybean, mustard, sunflower, groundnut, and sesamum — to improve yields and productivity.",
            "benefits": "Support Includes",
            "benefit1": "Free distribution of high-quality, climate-resilient oilseed varieties",
            "benefit2": "Micro-irrigation support, crop insurance coverage, and agri machinery access",
            "benefit3": "Beekeeping promotion and credit facilitation for farming operations",
            "target": "Direct aid to farmers to reduce cultivation costs and boost oilseed outputs significantly"
        },
        "pmfby": {
            "title": "Pradhan Mantri Fasal Bima Yojana (PMFBY)",
            "description": "Comprehensive crop insurance scheme covering food and oilseeds, protecting farmers against crop losses due to natural calamities, droughts, pests, and diseases.",
            "benefits": "Insurance Coverage",
            "benefit1": "Protection against crop losses from natural calamities, droughts, and pest attacks",
            "benefit2": "Stabilizes farm income and encourages sustained oilseed production",
            "benefit3": "Quick claim settlement process with minimal documentation",
            "target": "Protects oilseed farmers from unpredictable weather risks and ensures compensation for crop failure"
        },
        "msp": {
            "title": "Price Support & Procurement (PM-AASHA)",
            "description": "Government ensures minimum support price (MSP) and procurement of oilseeds to guarantee farmers get fair returns for their produce.",
            "budget": "₹15,000+ crore procurement plan",
            "benefits": "Price Protection",
            "benefit1": "Guaranteed minimum support price (MSP) for major oilseed crops",
            "benefit2": "Active procurement in states like Maharashtra, Telangana, Odisha, and Madhya Pradesh",
            "benefit3": "Market intervention to prevent price crashes and distress selling",
            "target": "Prevents distress selling and ensures better price realization for farmers throughout the year"
        },
        "state": {
            "title": "State Government Support Programs",
            "description": "Farmers benefit from state-level oilseed support initiatives including free seed minikit distribution, direct investment support, and price compensation schemes.",
            "benefits": "State-Level Benefits",
            "benefit1": "Free oilseed seed minikit distribution (e.g., UP) for toria, sesame, soybean, and groundnut",
            "benefit2": "Direct farmer investment support like Rythu Bandhu (Telangana) for cultivation expenses",
            "benefit3": "Price compensation schemes like Bhavantar Bhugtan Yojana (MP) protecting oilseed crop prices",
            "target": "Helps farmers access improved seeds without upfront costs and provides financial security through state support"
        },
